{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@flupcode/harness-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun script/build.ts",
    "test": "bun test src",
    "replay": "bun src/replay/cli.ts run",
    "replay:export": "bun src/replay/cli.ts export",
    "reflect:heuristics": "bun src/adaptive/learning/heuristics-cli.ts",
    "reflect:eval": "bun src/adaptive/learning/eval-cli.ts",
    "eval:live": "bun src/adaptive/promotion/cli.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@flupcode/remote": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@opencode/client": "2.0.18",
    "jsonc-parser": "3.3.1",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@flupcode/engine-contract": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
