{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@flupcode/desktop",
  "version": "1.17.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://flupcode.com",
  "description": "FlupCode desktop — a Claude Code–style harness for OpenCode.",
  "author": {
    "name": "FlupCode",
    "email": "hello@plazoleta.dev"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bash scripts/build-speech.sh && electron-vite dev",
    "build": "bun --cwd ../harness-server build && bash scripts/build-speech.sh && electron-vite build",
    "typecheck": "tsgo --noEmit",
    "renderer": "bun scripts/renderer.mjs",
    "dist": "bun --cwd ../harness-server build && node scripts/check-harness-server.mjs && bun run renderer && bash scripts/build-speech.sh && electron-vite build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.flupcode.desktop",
    "productName": "FlupCode",
    "copyright": "Copyright © 2026 FlupCode",
    "extraMetadata": {
      "desktopName": "flupcode.desktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "!out/speech",
      "package.json"
    ],
    "executableName": "flupcode",
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "../harness-server/dist/",
        "to": "harness-server",
        "filter": ["flupcode-harness", "flupcode-harness.exe"]
      }
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "rldona",
        "repo": "FlupCode"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "FlupCode-mac-${arch}.${ext}",
      "icon": "build/icon-mac.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FlupCode uses the microphone for voice dictation.",
        "NSSpeechRecognitionUsageDescription": "FlupCode turns your voice into text with Apple speech recognition."
      },
      "extraResources": [
        {
          "from": "out/speech",
          "to": "speech"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FlupCode-win-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "FlupCode-linux-x64.${ext}",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "flupcode"
        }
      }
    },
    "deb": {
      "packageName": "flupcode"
    },
    "rpm": {
      "packageName": "flupcode"
    }
  },
  "devDependencies": {
    "@flupcode/remote": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "42.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5",
    "typescript": "catalog:"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
