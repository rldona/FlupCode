{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@flupcode/engine-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Contract tests that drive a real OpenCode engine the way FlupCode does, against a stub model.",
  "exports": {
    "./engine": "./src/engine.ts",
    "./events": "./src/events.ts",
    "./model": "./src/model.ts",
    "./mcp": "./src/mcp.ts",
    "./mcp-browser": "./src/mcp-browser.ts"
  },
  "scripts": {
    "test": "FLUPCODE_CONTRACT_LINE=v2 bun test --timeout 120000",
    "opencode-v2": "bun script/opencode-v2.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@flupcode/remote": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
