{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@flupcode/relay",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "FlupCode remote control relay: routes end-to-end encrypted frames between desktops and phones.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile dist/relay.js",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@flupcode/remote": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
