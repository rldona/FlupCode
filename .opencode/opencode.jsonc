{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    // El taller de Content: tiempo, guardas y composición del mapa.
    // OAuth con registro dinámico, así que no hace falta clientId.
    "content": {
      "type": "remote",
      "url": "https://example.invalid/mcp",
      "enabled": true,
    },
    // Para probar en local contra el repo de Content, por stdio:
    // "content-local": {
    //   "type": "local",
    //   "command": ["python", "-m", "app.mcp"],
    //   "cwd": "../content-workspace/apps/api",
    //   "environment": { "MCP_TOKEN": "{env:MCP_TOKEN}" },
    // },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
