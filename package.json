{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "flupcode",
  "description": "FlupCode: a web and desktop app on the official OpenCode 2 engine",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:harness": "bun --cwd packages/harness dev",
    "build:harness": "bun --cwd packages/harness build",
    "dev:harness-desktop": "bun --cwd packages/harness-desktop dev",
    "build:harness-desktop": "bun --cwd packages/harness-desktop build",
    "repo-hygiene": "bun script/repo-hygiene.ts",
    "opencode-pin": "bun script/opencode-pin.ts",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.3.13",
      "@shikijs/stream": "4.2.0",
      "@types/node": "24.12.2",
      "@tsconfig/bun": "1.0.9",
      "@tailwindcss/vite": "4.1.11",
      "dompurify": "3.3.1",
      "marked": "18.0.7",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "@playwright/test": "1.59.1",
      "playwright": "1.59.1",
      "playwright-core": "1.59.1",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "shiki": "4.2.0",
      "tailwindcss": "4.1.11",
      "vite": "7.1.4",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rldona/FlupCode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch"
  }
}
